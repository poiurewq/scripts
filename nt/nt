#!/usr/bin/env zsh
set -e


bf=$(tput bold 2>/dev/null) || bf=''
nf=$(tput sgr0 2>/dev/null) || nf=''
uf=$(tput smul 2>/dev/null) || uf=''


nt_template_name='nt_template'
NT_VERSION="0.5.0"
_nt_prefix=''

_nt_idx_pat='^([0-9]+(\.[0-9]+)*)([-_]|\.[^0-9]|$)'  # extract: index + boundary
_nt_idx_strict='^[0-9]+(\.[0-9]+)*$'        # validate/consume: full-string match
_nt_range_pat='^[0-9]+(\.[0-9]+)*-[0-9]+(\.[0-9]+)*$'  # range token (hierarchical)
_nt_digits='^[0-9]+$'                        # bare digits

nt_editor="${NT_EDITOR:-${VISUAL:-${EDITOR:-vim}}}"

nt_syn_r="${bf}rename${nf} ${uf}num${nf} ${uf}title${nf}"


NT_PLATFORM='other'

nt_platform_detect() {
	case "$OSTYPE" in
		darwin*)  NT_PLATFORM='darwin' ;;
		linux*)   NT_PLATFORM='linux'  ;;
		*)        NT_PLATFORM='other'  ;;
	esac
}

nt_open_app() {
	local app_name="$1"; shift
	case "$NT_PLATFORM" in
		darwin) open -a "$app_name" "$@" ;;
		*)      "$app_name" "$@" ;;
	esac
}

nt_copy_to_clipboard() {
	local string="$1"
	case "$NT_PLATFORM" in
		darwin)
			printf '%s' "$string" | pbcopy
			;;
		linux)
			printf '%s' "$string" | xsel --clipboard --input 2>/dev/null \
				|| printf '%s' "$string" | xclip -selection clipboard 2>/dev/null \
				|| return 1
			;;
		*)
			return 1
			;;
	esac
}

nt_stat_mtime_ym() {
	case "$NT_PLATFORM" in
		darwin) stat -f "%Sm" -t "%Y-%m" "$@" ;;
		*)      stat -c "%y" "$@" | cut -d'-' -f1,2 ;;
	esac
}


nt_err() {
	printf '%s\n' "$1" >&2
}


nt_load_config() {
	local config_file=".nt/config"
	[[ -f "$config_file" ]] || return 0
	local line key val
	while IFS= read -r line; do
		[[ "$line" =~ ^[[:space:]]*'#' ]] && continue
		[[ "$line" =~ ^[[:space:]]*$ ]] && continue
		[[ "$line" != *=* ]] && continue
		key="${line%%=*}"
		val="${line#*=}"
		case "$key" in
			prefix) _nt_prefix="$val" ;;
		esac
	done < "$config_file"
}

_nt_template_file=''
nt_resolve_template() {
	_nt_template_file=''
	local -a dotnt_templates cwd_templates
	dotnt_templates=( .nt/template.*(N.) )
	cwd_templates=( ${nt_template_name}.*(N.) )

	if [[ ${#dotnt_templates[@]} -gt 1 ]]; then
		nt_err "Too many template files in .nt/."
		return 1
	elif [[ ${#dotnt_templates[@]} -eq 1 ]]; then
		_nt_template_file="${dotnt_templates[1]}"
		return 0
	fi

	if [[ ${#cwd_templates[@]} -gt 1 ]]; then
		nt_err "Too many nt template files in this folder."
		return 1
	elif [[ ${#cwd_templates[@]} -eq 1 ]]; then
		local cwd_tmpl="${cwd_templates[1]}"
		local ext="${cwd_tmpl##*.}"
		mkdir -p .nt
		\mv "$cwd_tmpl" ".nt/template.${ext}"
		nt_err "Migrated ${cwd_tmpl} -> .nt/template.${ext}"
		_nt_template_file=".nt/template.${ext}"
	fi
}

nt_open() {
	local app_or_cmd="$1"; shift
	local -a file_list=("$@")

	if command -v "${app_or_cmd}" >/dev/null 2>&1; then
		case "$app_or_cmd" in
			vi|vim) vim -p "${file_list[@]}" ;;
			*) "${app_or_cmd}" "${file_list[@]}" ;;
		esac
	else
		nt_open_app "${app_or_cmd}" "${file_list[@]}"
	fi
}

extract_index() {
	local f="$1"
	local stripped="${f#${_nt_prefix}}"
	if [[ "$stripped" =~ $_nt_idx_pat ]]; then
		printf '%s' "${match[1]}"
	fi
}

compare_indices() {
	local a="$1" b="$2"
	local -a ap bp
	ap=( "${(@s:.:)a}" )
	bp=( "${(@s:.:)b}" )
	local i max_len av bv
	max_len=$(( ${#ap[@]} > ${#bp[@]} ? ${#ap[@]} : ${#bp[@]} ))
	for (( i = 1; i <= max_len; i++ )); do
		av=$(( 10#${ap[$i]:-0} ))
		bv=$(( 10#${bp[$i]:-0} ))
		if (( av < bv )); then printf -- '-1'; return 0; fi
		if (( av > bv )); then printf '1';  return 0; fi
	done
	printf '0'
}

increment_index() {
	local idx="$1"
	if [[ -z "$idx" ]]; then
		nt_err "increment_index: empty index"
		return 1
	fi
	local -a parts
	parts=( "${(@s:.:)idx}" )
	parts[-1]=$(( 10#${parts[-1]} + 1 ))
	local i
	for (( i = 1; i <= ${#parts[@]}; i++ )); do
		parts[$i]="$(printf '%03d' "$(( 10#${parts[$i]} ))")"
	done
	printf '%s' "${(j:.:)parts}"
}

sort_docs_by_index() {
	[[ "$#" -eq 0 ]] && return 0
	local -a pairs
	local f idx
	for f in "$@"; do
		idx="$(extract_index "$f")"
		[[ -z "$idx" ]] && continue
		pairs+=( "${idx}"$'\t'"${f}" )
	done
	local -a sorted
	sorted=( "${(@o)pairs}" )
	local pair
	for pair in "${sorted[@]}"; do
		printf '%s\n' "${pair#*$'\t'}"
	done
}

last_indexed_doc() {
	local -a docs _lid_filtered
	if [[ -n "$_nt_prefix" ]]; then
		docs=( ${_nt_prefix}[[:digit:]]##*(N.) )
	else
		docs=( [[:digit:]]##*(N.) )
	fi
	_lid_filtered=()
	local _lid_f
	for _lid_f in "${docs[@]}"; do
		nt_is_skip_ext "$_lid_f" || _lid_filtered+=( "$_lid_f" )
	done
	docs=( "${_lid_filtered[@]}" )
	if [[ ${#docs[@]} -eq 0 ]]; then
		return 1
	fi
	local sorted_last
	sorted_last="$(sort_docs_by_index "${docs[@]}" | tail -n1)"
	printf '%s' "$sorted_last"
}

last_index() {
	local doc
	doc="$(last_indexed_doc 2>/dev/null)" || return 1
	extract_index "$doc"
}

get_delimiter() {
	local name="$1"
	local idx
	idx="$(extract_index "$name")"
	[[ -z "$idx" ]] && return
	local rest="${name#${idx}}"
	if [[ "$rest" == _* ]]; then
		[[ "$rest" =~ ^(_+) ]] && printf '%s' "${match[1]}"
	elif [[ "$rest" == -* ]]; then
		[[ "$rest" =~ ^(-+) ]] && printf '%s' "${match[1]}"
	fi
}

get_extension() {
	local filename="$1"
	local ext="${filename##*.}"
	if [[ "$ext" == "$filename" ]] || [[ "$ext" =~ $_nt_digits ]]; then
		return 1
	fi
	printf '%s' "$ext"
}

nt_is_skip_ext() {
	local f="$1"
	local ext="${f##*.}"
	[[ "$ext" == "$f" ]] && return 1  # no extension
	case "${ext:l}" in
		png|jpg|jpeg|gif|bmp|tiff|tif|webp|svg|ico|heic|heif|\
		mov|mp4|avi|mkv|webm|wmv|flv|m4v|\
		mp3|wav|aac|flac|ogg|m4a|aiff|opus|\
		pdf|doc|docx|xls|xlsx|ppt|pptx|\
		zip|tar|gz|bz2|7z|rar)
			return 0 ;;
		*) return 1 ;;
	esac
}

find_doc_by_index() {
	local idx="$1"
	local -a parts
	parts=( "${(@s:.:)idx}" )
	local i
	for (( i = 1; i <= ${#parts[@]}; i++ )); do
		parts[$i]="$(printf '%03d' "$(( 10#${parts[$i]} ))")"
	done
	local normalized="${(j:.:)parts}"

	local -a candidates
	candidates=( ${_nt_prefix}${normalized}*(N.) )

	local -a docs
	local f file_idx
	for f in "${candidates[@]}"; do
		file_idx="$(extract_index "$f")"
		if [[ "$file_idx" == "$normalized" ]]; then
			docs+=( "$f" )
		fi
	done

	if [[ ${#docs[@]} -eq 0 ]]; then
		nt_err "File with index ${normalized} not found."
		return 1
	fi
	if [[ ${#docs[@]} -gt 1 ]]; then
		if [[ -t 2 ]]; then
			printf 'Multiple files with index %s:\n' "$normalized" >&2
			for (( i = 1; i <= ${#docs[@]}; i++ )); do
				printf '  %d) %s\n' "$i" "${docs[$i]}" >&2
			done
			local choice
			printf 'Select [1-%d]: ' "${#docs[@]}" >&2
			read -r choice </dev/tty
			if ! [[ "$choice" =~ $_nt_digits ]] \
				|| (( choice < 1 || choice > ${#docs[@]} )); then
				nt_err "Invalid selection."
				return 1
			fi
			printf '%s' "${docs[$choice]}"
		else
			nt_err "Multiple files with index ${normalized}: ${docs[*]}"
			return 1
		fi
		return 0
	fi
	printf '%s' "${docs[1]}"
}

index_has_doc() {
	local idx="$1"
	local -a parts
	parts=( "${(@s:.:)idx}" )
	local i
	for (( i = 1; i <= ${#parts[@]}; i++ )); do
		parts[$i]="$(printf '%03d' "$(( 10#${parts[$i]} ))")"
	done
	local normalized="${(j:.:)parts}"
	local -a candidates
	candidates=( ${_nt_prefix}${normalized}*(N.) )
	local f
	for f in "${candidates[@]}"; do
		[[ "$(extract_index "$f")" == "$normalized" ]] && return 0
	done
	return 1
}

validate_index() {
	local idx="$1"
	if ! [[ "$idx" =~ $_nt_idx_strict ]]; then
		nt_err "Invalid index: ${idx}"
		return 1
	fi
	local -a parts
	parts=( "${(@s:.:)idx}" )
	if [[ $(( 10#${parts[1]} )) -lt 1 ]]; then
		nt_err "Index must start with a positive integer: ${idx}"
		return 1
	fi
	local p
	for p in "${parts[@]}"; do
		if [[ $(( 10#$p )) -gt 999 ]]; then
			nt_err "Index component out of range (0-999): ${p}"
			return 1
		fi
	done
}

consume_title() {
	_consume_title_raw=""
	_consume_title_result=""
	_nt_consumed=0
	local arg
	for arg in "$@"; do
		if [[ $_nt_greedy -eq 0 ]]; then
			if [[ "$arg" == -* ]]; then
				break
			fi
		fi
		if [[ $_nt_consumed -eq 0 ]]; then
			_consume_title_raw="$arg"
		else
			_consume_title_raw+=" $arg"
		fi
		(( _nt_consumed++ )) || true
	done
	_consume_title_result="${_consume_title_raw// /-}"
}

build_filename() {
	local index="$1" delimiter="$2" title="$3" extension="$4"
	local result="$index"
	if [[ -n "$title" ]]; then
		if [[ -z "$delimiter" ]]; then
			delimiter="-"
		fi
		result+="${delimiter}${title}"
	fi
	if [[ -n "$extension" ]]; then
		result+=".${extension}"
	fi
	printf '%s' "$result"
}


cmd_help() {
	printf '\n'
	printf 'nt — simple notes maintainer\n\n'
	printf 'usage: nt <command> [args]\n\n'
	printf '  nt h                print this help (alias: help)\n'
	printf '  nt n [i INDEX] [c INDEX] [TITLE]\n'
	printf '                      create new indexed document (alias: new)\n'
	printf '  nt l [N]            open last (or Nth-to-last) document (alias: last)\n'
	printf '  nt li               print last index number (alias: last-index)\n'
	printf '  nt NUM [NUM ...]    open document(s) by index (supports N.M hierarchical)\n'
	printf '  nt NUM-NUM          open range of documents (inclusive, hierarchical)\n'
	printf '  nt NUM..            open all descendants under index\n'
	printf '  nt NUM.             open immediate children of index\n'
	printf '  nt r NUM TITLE      rename document by index (alias: rename)\n'
	printf '  nt rl TITLE         rename last document\n'
	printf '  nt ri N M           reindex document N to index M (alias: reindex)\n'
	printf '  nt ri N-M A-B       reindex range N..M to A..B one-to-one\n'
	printf '  nt a                activity summary, current dir (alias: activity)\n'
	printf '  nt ar               activity summary, recursive (alias: activity-recursive)\n'
	printf '  nt R                open README.md\n'
	printf '  nt C                open CLAUDE.md\n'
	printf '  nt t                open template file\n'
	printf '  nt config prefix S  set custom filename prefix (stored in .nt/config)\n'
	printf '  nt v                print version (alias: version)\n'
	printf '  nt util month       rename files: month names → 2-digit numbers\n'
	printf '  nt util delim D     rename nt-indexed files to use delimiter D\n'
	printf '  nt util ext E       rename nt-indexed files to use extension E\n'
	printf '\nBare commands (no hyphen) consume all remaining words as the title.\n'
	printf 'Hyphen-prefixed commands stop at numbers/flags, enabling chaining;\n'
	printf 'chained commands are processed in the sequence they are passed:\n'
	printf '  nt -n new note one -n new note two\n'
	printf '  creates two new notes and opens both of them\n\n'
	printf 'To get started, type: man nt  (see the EXAMPLES section)\n\n'
}

cmd_version() {
	printf 'nt %s\n' "$NT_VERSION"
}

cmd_new() {
	local custom_idx="" copy_src=""
	local -a remaining=()
	while [[ "$#" -gt 0 ]]; do
		case "$1" in
			i|index)
				shift
				if [[ "$#" -eq 0 ]]; then
					nt_err "Missing index after i/index"
					exit 1
				fi
				custom_idx="$1"; shift
				;;
			c|copy)
				shift
				if [[ "$#" -eq 0 ]]; then
					nt_err "Missing index after c/copy"
					exit 1
				fi
				copy_src="$1"; shift
				;;
			*)
				remaining+=( "$1" ); shift
				;;
		esac
	done

	local _subopts_consumed=0
	[[ -n "$custom_idx" ]] && (( _subopts_consumed += 2 ))
	[[ -n "$copy_src" ]]   && (( _subopts_consumed += 2 ))

	local new_idx
	if [[ -n "$custom_idx" ]]; then
		validate_index "$custom_idx" || exit 2
		local -a ci_parts
		ci_parts=( "${(@s:.:)custom_idx}" )
		local _ci_i
		for (( _ci_i = 1; _ci_i <= ${#ci_parts[@]}; _ci_i++ )); do
			ci_parts[$_ci_i]="$(printf '%03d' "$(( 10#${ci_parts[$_ci_i]} ))")"
		done
		new_idx="${(j:.:)ci_parts}"
		if find_doc_by_index "$new_idx" >/dev/null 2>&1; then
			nt_err "Document with index ${new_idx} already exists."
			exit 2
		fi
	else
		local last_idx
		last_idx="$(last_index 2>/dev/null)" || last_idx=""
		if [[ -z "$last_idx" ]]; then
			new_idx="001"
		else
			new_idx="$(increment_index "$last_idx")"
		fi
	fi

	local copy_doc=""
	if [[ -n "$copy_src" ]]; then
		validate_index "$copy_src" || exit 2
		copy_doc="$(find_doc_by_index "$copy_src")" || exit 2
	fi

	local last_doc
	last_doc="$(last_indexed_doc 2>/dev/null)" || last_doc=""

	local new_doc new_title_raw new_title
	if [[ "${#remaining[@]}" -gt 0 ]]; then
		consume_title "${remaining[@]}"
		new_title_raw="$_consume_title_raw"
		new_title="$_consume_title_result"
		local last_delim
		last_delim="$(get_delimiter "$last_doc")"
		if [[ -z "$last_delim" ]]; then
			new_doc="${new_idx}-${new_title}"
		else
			new_doc="${new_idx}${last_delim}${new_title}"
		fi
	else
		_nt_consumed=0
		new_doc="${new_idx}"
		new_title_raw=""
	fi
	new_doc="${_nt_prefix}${new_doc}"
	(( _nt_consumed += _subopts_consumed )) || true

	if [[ -n "$copy_doc" ]]; then
		local copy_ext
		copy_ext="$(get_extension "$copy_doc" 2>/dev/null)" || copy_ext="md"
		new_doc+=".${copy_ext}"
		\cp "$copy_doc" "$new_doc"
	else
		nt_resolve_template || exit 5
		if [[ -n "$_nt_template_file" ]]; then
			new_doc+=".${_nt_template_file##*.}"
			sed -e "s|%DATE|$(date '+%Y-%m-%d')|g" \
				-e "s|%TITLE|${new_title_raw}|g" \
				"$_nt_template_file" >> "$new_doc"
		else
			local last_ext
			if [[ -z "$last_doc" ]]; then
				last_ext="md"
			else
				last_ext="$(get_extension "$last_doc" 2>/dev/null)" || last_ext="md"
			fi
			new_doc+=".${last_ext}"
			local new_time
			new_time="$(date '+%Y.%m.%d-%H:%M')"
			printf "created=${new_time}\n" >> "${new_doc}"
			printf '\n\n\n' >> "${new_doc}"
		fi
	fi
	files_to_open+=( "${new_doc}" )
}

cmd_last() {
	local last_doc
	last_doc="$(last_indexed_doc 2>/dev/null)" || {
		nt_err "No indexed document found."
		exit 2
	}

	if [[ "$#" -gt 0 ]] && [[ "$1" == -* ]] && [[ $_nt_greedy -eq 0 ]]; then
		_nt_consumed=0
		files_to_open+=( "$last_doc" )
		return 0
	fi

	if [ "$#" -eq 0 ]; then
		_nt_consumed=0
		files_to_open+=( "$last_doc" )
	elif [[ "$1" =~ $_nt_digits ]]; then
		_nt_consumed=1
		local nth="$1"
		local -a all_docs _cl_filtered
		if [[ -n "$_nt_prefix" ]]; then
			all_docs=( ${_nt_prefix}[[:digit:]]##*(N.) )
		else
			all_docs=( [[:digit:]]##*(N.) )
		fi
		_cl_filtered=()
		local _cl_f
		for _cl_f in "${all_docs[@]}"; do
			nt_is_skip_ext "$_cl_f" || _cl_filtered+=( "$_cl_f" )
		done
		all_docs=( "${_cl_filtered[@]}" )
		local sorted_output
		sorted_output="$(sort_docs_by_index "${all_docs[@]}")"
		local -a sorted_docs
		sorted_docs=( "${(f)sorted_output}" )
		local total=${#sorted_docs[@]}
		if (( nth < 1 )) || (( nth > total )); then
			nt_err "Only ${total} indexed document(s) found."
			exit 2
		fi
		local idx=$(( total - nth + 1 ))
		files_to_open+=( "${sorted_docs[$idx]}" )
	else
		nt_err "Invalid argument for last: $1"
		exit 2
	fi
}

cmd_last_index() {
	local idx
	idx="$(last_index 2>/dev/null)" || {
		nt_err "No indexed document found."
		exit 2
	}
	local -a parts
	parts=( "${(@s:.:)idx}" )
	local -a stripped
	local p
	for p in "${parts[@]}"; do
		stripped+=( "$(( 10#$p ))" )
	done
	printf '%s\n' "${(j:.:)stripped}"
}

cmd_open() {
	validate_index "$1" || exit 2
	local doc
	doc="$(find_doc_by_index "$1")" || exit 2
	files_to_open+=( "$doc" )
}

cmd_rename() {
	if [ "$#" -lt 2 ]; then
		printf 'usage: %s\n' "${nt_syn_r}"
		exit 1
	fi
	validate_index "$1" || exit 2
	local try_doc
	try_doc="$(find_doc_by_index "$1")" || exit 2
	local try_idx
	try_idx="$(extract_index "$try_doc")"
	shift
	consume_title "$@"
	if [ -z "$_consume_title_result" ]; then
		printf 'usage: %s\n' "${nt_syn_r}"
		exit 1
	fi
	local new_title="$_consume_title_result"
	local try_doc_ext try_delim new_doc
	try_doc_ext="$(get_extension "$try_doc" 2>/dev/null)" || try_doc_ext="${try_doc##*.}"
	try_delim="$(get_delimiter "$try_doc")"
	if [ -z "$try_delim" ]; then
		new_doc="${_nt_prefix}${try_idx}-${new_title}.${try_doc_ext}"
	else
		new_doc="${_nt_prefix}${try_idx}${try_delim}${new_title}.${try_doc_ext}"
	fi
	\mv "${try_doc}" "${new_doc}" \
		&& printf '%s renamed to %s\n' "${try_doc}" "${new_doc}"
}

cmd_rename_last() {
	if [ "$#" -eq 0 ]; then
		nt_err "usage: nt rl <title>"
		exit 1
	fi
	local last_doc
	last_doc="$(last_indexed_doc 2>/dev/null)" || {
		nt_err "No indexed document found."
		exit 2
	}
	local last_idx
	last_idx="$(extract_index "$last_doc")"
	consume_title "$@"
	if [ -z "$_consume_title_result" ]; then
		nt_err "usage: nt rl <title>"
		exit 1
	fi
	local new_title="$_consume_title_result"
	local last_delim last_ext new_doc
	last_delim="$(get_delimiter "$last_doc")"
	last_ext="$(get_extension "$last_doc" 2>/dev/null)" || last_ext="${last_doc##*.}"
	if [ -z "$last_delim" ]; then
		new_doc="${_nt_prefix}${last_idx}-${new_title}.${last_ext}"
	else
		new_doc="${_nt_prefix}${last_idx}${last_delim}${new_title}.${last_ext}"
	fi
	\mv "${last_doc}" "${new_doc}" \
		&& printf '%s renamed to %s\n' "${last_doc}" "${new_doc}"
}

cmd_reindex() {
	if [[ "$#" -lt 2 ]]; then
		nt_err "usage: nt ri <index> <index> | nt ri <range> <range>"
		exit 1
	fi
	local ri_arg1="$1" ri_arg2="$2"

	local ri1_range=0 ri2_range=0
	[[ "$ri_arg1" =~ $_nt_range_pat ]] && ri1_range=1
	[[ "$ri_arg2" =~ $_nt_range_pat ]] && ri2_range=1

	if [[ $ri1_range -ne $ri2_range ]]; then
		nt_err "ri: both arguments must be the same form (both indices or both ranges)"
		exit 2
	fi

	if [[ $ri1_range -eq 0 ]]; then
		validate_index "$ri_arg1" || exit 2
		validate_index "$ri_arg2" || exit 2

		local -a ri_cur_p ri_new_p
		ri_cur_p=( "${(@s:.:)ri_arg1}" )
		ri_new_p=( "${(@s:.:)ri_arg2}" )
		local _ri_i
		for (( _ri_i = 1; _ri_i <= ${#ri_cur_p[@]}; _ri_i++ )); do
			ri_cur_p[$_ri_i]="$(printf '%03d' "$(( 10#${ri_cur_p[$_ri_i]} ))")"
		done
		for (( _ri_i = 1; _ri_i <= ${#ri_new_p[@]}; _ri_i++ )); do
			ri_new_p[$_ri_i]="$(printf '%03d' "$(( 10#${ri_new_p[$_ri_i]} ))")"
		done
		local ri_norm_cur="${(j:.:)ri_cur_p}" ri_norm_new="${(j:.:)ri_new_p}"

		if [[ "$ri_norm_cur" == "$ri_norm_new" ]]; then
			printf 'Nothing to reindex.\n'; exit 0
		fi

		local ri_doc
		ri_doc="$(find_doc_by_index "$ri_norm_cur")" || exit 2
		if find_doc_by_index "$ri_norm_new" >/dev/null 2>&1; then
			nt_err "Document with index ${ri_norm_new} already exists."
			exit 2
		fi
		local ri_file_idx
		ri_file_idx="$(extract_index "$ri_doc")"
		local ri_new_doc="${_nt_prefix}${ri_norm_new}${ri_doc#${_nt_prefix}${ri_file_idx}}"
		\mv "${ri_doc}" "${ri_new_doc}" \
			&& printf '%s reindexed to %s\n' "${ri_doc}" "${ri_new_doc}"
		return
	fi

	local src_start="${ri_arg1%%-*}" src_end="${ri_arg1##*-}"
	local tgt_start="${ri_arg2%%-*}" tgt_end="${ri_arg2##*-}"

	validate_index "$src_start" || exit 2
	validate_index "$src_end"   || exit 2
	validate_index "$tgt_start" || exit 2
	validate_index "$tgt_end"   || exit 2

	local -a ss_p se_p ts_p te_p
	ss_p=( "${(@s:.:)src_start}" ); se_p=( "${(@s:.:)src_end}" )
	ts_p=( "${(@s:.:)tgt_start}" ); te_p=( "${(@s:.:)tgt_end}" )
	local _ri_i
	for (( _ri_i = 1; _ri_i <= ${#ss_p[@]}; _ri_i++ )); do
		ss_p[$_ri_i]="$(printf '%03d' "$(( 10#${ss_p[$_ri_i]} ))")"
	done
	for (( _ri_i = 1; _ri_i <= ${#se_p[@]}; _ri_i++ )); do
		se_p[$_ri_i]="$(printf '%03d' "$(( 10#${se_p[$_ri_i]} ))")"
	done
	for (( _ri_i = 1; _ri_i <= ${#ts_p[@]}; _ri_i++ )); do
		ts_p[$_ri_i]="$(printf '%03d' "$(( 10#${ts_p[$_ri_i]} ))")"
	done
	for (( _ri_i = 1; _ri_i <= ${#te_p[@]}; _ri_i++ )); do
		te_p[$_ri_i]="$(printf '%03d' "$(( 10#${te_p[$_ri_i]} ))")"
	done
	local norm_ss="${(j:.:)ss_p}" norm_se="${(j:.:)se_p}"
	local norm_ts="${(j:.:)ts_p}" norm_te="${(j:.:)te_p}"

	if [[ ${#ss_p[@]} -ne ${#se_p[@]} ]]; then
		nt_err "ri: source range endpoints must be at the same index depth"
		exit 2
	fi
	if [[ ${#ts_p[@]} -ne ${#te_p[@]} ]]; then
		nt_err "ri: target range endpoints must be at the same index depth"
		exit 2
	fi

	if [[ ${#ss_p[@]} -gt 1 ]]; then
		if [[ "${(j:.:)ss_p[1,-2]}" != "${(j:.:)se_p[1,-2]}" ]]; then
			nt_err "ri: source range endpoints must share the same parent index"
			exit 2
		fi
	fi
	if [[ ${#ts_p[@]} -gt 1 ]]; then
		if [[ "${(j:.:)ts_p[1,-2]}" != "${(j:.:)te_p[1,-2]}" ]]; then
			nt_err "ri: target range endpoints must share the same parent index"
			exit 2
		fi
	fi

	local src_first_last=$(( 10#${ss_p[-1]} ))
	local src_last_last=$(( 10#${se_p[-1]} ))
	local tgt_first_last=$(( 10#${ts_p[-1]} ))
	local tgt_last_last=$(( 10#${te_p[-1]} ))

	if (( src_first_last > src_last_last )); then
		nt_err "ri: source range start is greater than end: ${norm_ss}-${norm_se}"
		exit 2
	fi
	if (( tgt_first_last > tgt_last_last )); then
		nt_err "ri: target range start is greater than end: ${norm_ts}-${norm_te}"
		exit 2
	fi

	local src_span=$(( src_last_last - src_first_last ))
	local tgt_span=$(( tgt_last_last - tgt_first_last ))
	if [[ $src_span -ne $tgt_span ]]; then
		nt_err "ri: source range (${norm_ss}-${norm_se}) and target range (${norm_ts}-${norm_te}) must span the same number of indices"
		exit 2
	fi

	if [[ "$norm_ss" == "$norm_ts" ]] && [[ "$norm_se" == "$norm_te" ]]; then
		printf 'Nothing to reindex.\n'; exit 0
	fi

	index_has_doc "$norm_ss" || exit 2

	local -a ri_src_idxs ri_tgt_idxs
	local _ri_n _ri_sa _ri_ta _ri_si _ri_ti
	for (( _ri_n = 0; _ri_n <= src_span; _ri_n++ )); do
		_ri_sa=( "${ss_p[@]}" ); _ri_ta=( "${ts_p[@]}" )
		_ri_sa[-1]="$(printf '%03d' "$(( src_first_last + _ri_n ))")"
		_ri_ta[-1]="$(printf '%03d' "$(( tgt_first_last + _ri_n ))")"
		ri_src_idxs+=( "${(j:.:)_ri_sa}" )
		ri_tgt_idxs+=( "${(j:.:)_ri_ta}" )
	done

	local _ri_chk_doc='' _ri_chk_idx='' _ri_is_src=0 _ri_s=''
	for (( _ri_n = 1; _ri_n <= ${#ri_src_idxs[@]}; _ri_n++ )); do
		_ri_si="${ri_src_idxs[$_ri_n]}"
		_ri_ti="${ri_tgt_idxs[$_ri_n]}"
		index_has_doc "$_ri_si" || continue
		if _ri_chk_doc="$(find_doc_by_index "$_ri_ti" 2>/dev/null)"; then
			_ri_chk_idx="$(extract_index "$_ri_chk_doc")"
			_ri_is_src=0
			for _ri_s in "${ri_src_idxs[@]}"; do
				[[ "$_ri_chk_idx" == "$_ri_s" ]] && { _ri_is_src=1; break; }
			done
			if [[ $_ri_is_src -eq 0 ]]; then
				nt_err "Target index ${_ri_ti} already occupied by ${_ri_chk_doc}."
				exit 2
			fi
		fi
	done

	local -a ri_seq
	if [[ "$(compare_indices "$norm_ts" "$norm_ss")" == "1" ]]; then
		for (( _ri_n = ${#ri_src_idxs[@]}; _ri_n >= 1; _ri_n-- )); do ri_seq+=( "$_ri_n" ); done
	else
		for (( _ri_n = 1; _ri_n <= ${#ri_src_idxs[@]}; _ri_n++ )); do ri_seq+=( "$_ri_n" ); done
	fi

	local -a _ri_messages=()
	local _ri_doc='' _ri_file_idx='' _ri_new_doc=''
	for _ri_n in "${ri_seq[@]}"; do
		_ri_si="${ri_src_idxs[$_ri_n]}"
		_ri_ti="${ri_tgt_idxs[$_ri_n]}"
		index_has_doc "$_ri_si" || continue
		_ri_doc="$(find_doc_by_index "$_ri_si")" || continue
		_ri_file_idx="$(extract_index "$_ri_doc")"
		_ri_new_doc="${_nt_prefix}${_ri_ti}${_ri_doc#${_nt_prefix}${_ri_file_idx}}"
		\mv "${_ri_doc}" "${_ri_new_doc}" \
			&& _ri_messages+=( "${_ri_doc} -> ${_ri_new_doc}" )
	done
	printf '%s\n' "${_ri_messages[@]}"
}

cmd_activity() {
	local -a nt_files _act_filtered
	if [ "$1" = "ar" ]; then
		if [[ -n "$_nt_prefix" ]]; then
			nt_files=( **/${_nt_prefix}[[:digit:]]##*(N.) )
		else
			nt_files=( **/[[:digit:]]##*(N.) )
		fi
	else
		if [[ -n "$_nt_prefix" ]]; then
			nt_files=( ${_nt_prefix}[[:digit:]]##*(N.) )
		else
			nt_files=( [[:digit:]]##*(N.) )
		fi
	fi
	_act_filtered=()
	local _act_f
	for _act_f in "${nt_files[@]}"; do
		nt_is_skip_ext "$_act_f" || _act_filtered+=( "$_act_f" )
	done
	nt_files=( "${_act_filtered[@]}" )
	if [ "${#nt_files[@]}" -eq 0 ]; then
		printf 'No indexed documents found.\n'
		exit 0
	fi
	printf '\nActivity Summary\n================\n\n'
	nt_stat_mtime_ym "${nt_files[@]}" \
		| sort | uniq -c | sort -k2 \
		| while read count month; do
			bar=$(printf '%*s' "$count" '' | tr ' ' '#')
			printf "  %s  %3d  %s\n" "$month" "$count" "$bar"
		done
	printf '\n  Total: %d documents\n\n' "${#nt_files[@]}"
}

cmd_subtree() {
	local prefix="$1" mode="$2"   # mode: "all" or "immediate"
	if ! [[ "$prefix" =~ $_nt_idx_strict ]]; then
		nt_err "Unknown option '${prefix}'"
		exit 2
	fi
	validate_index "$prefix" || exit 2
	local -a _st_parts
	_st_parts=( "${(@s:.:)prefix}" )
	local _st_i
	for (( _st_i = 1; _st_i <= ${#_st_parts[@]}; _st_i++ )); do
		_st_parts[$_st_i]="$(printf '%03d' "$(( 10#${_st_parts[$_st_i]} ))")"
	done
	local _st_norm="${(j:.:)_st_parts}"
	local _st_depth=${#_st_parts[@]}

	local -a _st_all_docs _st_matches _st_filtered
	if [[ -n "$_nt_prefix" ]]; then
		_st_all_docs=( ${_nt_prefix}[[:digit:]]##*(N.) )
	else
		_st_all_docs=( [[:digit:]]##*(N.) )
	fi
	_st_filtered=()
	local _st_f _st_idx
	for _st_f in "${_st_all_docs[@]}"; do
		nt_is_skip_ext "$_st_f" || _st_filtered+=( "$_st_f" )
	done
	_st_all_docs=( "${_st_filtered[@]}" )
	_st_matches=()
	for _st_f in "${_st_all_docs[@]}"; do
		_st_idx="$(extract_index "$_st_f")"
		[[ -z "$_st_idx" ]] && continue
		if [[ "$_st_idx" == ${_st_norm}.* ]]; then
			if [[ "$mode" == "immediate" ]]; then
				local -a _st_child_parts
				_st_child_parts=( "${(@s:.:)_st_idx}" )
				[[ ${#_st_child_parts[@]} -ne $(( _st_depth + 1 )) ]] && continue
			fi
			_st_matches+=( "$_st_f" )
		fi
	done
	if [[ ${#_st_matches[@]} -eq 0 ]]; then
		nt_err "No sub-documents found under ${prefix}."
		exit 2
	fi
	local _st_sorted _st_line
	_st_sorted="$(sort_docs_by_index "${_st_matches[@]}")"
	while IFS= read -r _st_line; do
		files_to_open+=( "$_st_line" )
	done <<< "$_st_sorted"
}

cmd_readme() {
	local -a readmes
	readmes=( (#i)readme.md(N.) )
	if [[ ${#readmes[@]} -eq 0 ]]; then
		touch README.md
		readmes=( README.md )
	fi
	files_to_open+=( "${readmes[1]}" )
}

cmd_claude() {
	local -a claudes
	claudes=( (#i)claude.md(N.) )
	if [[ ${#claudes[@]} -eq 0 ]]; then
		touch CLAUDE.md
		claudes=( CLAUDE.md )
	fi
	files_to_open+=( "${claudes[1]}" )
}

cmd_template() {
	nt_resolve_template || exit 5
	if [[ -n "$_nt_template_file" ]]; then
		files_to_open+=( "$_nt_template_file" )
	else
		mkdir -p .nt
		touch ".nt/template.md"
		files_to_open+=( ".nt/template.md" )
	fi
}

cmd_config() {
	if [[ "$#" -lt 2 ]]; then
		nt_err "usage: nt config prefix <string>"
		exit 1
	fi
	case "$1" in
		prefix)
			local new_prefix="$2"
			mkdir -p .nt
			local config_file=".nt/config"
			local tmp_file
			tmp_file="$(mktemp)"
			{
				if [[ -f "$config_file" ]]; then
					grep -v '^prefix=' "$config_file" || true
				fi
				printf 'prefix=%s\n' "$new_prefix"
			} > "$tmp_file"
			\mv "$tmp_file" "$config_file"
			printf 'config: prefix=%s\n' "$new_prefix"
			;;
		*)
			nt_err "Unknown config key: $1"
			nt_err "usage: nt config prefix <string>"
			exit 2
			;;
	esac
}

cmd_util_month() {
	local -a all_files
	all_files=( *(N.) )
	if [[ ${#all_files[@]} -eq 0 ]]; then
		printf 'No files found in current directory.\n'
		return 0
	fi

	local -a full_names full_nums abbr_names abbr_nums
	full_names=( January February March April May June July August September October November December )
	full_nums=(  01      02       03    04    05  06   07   08     09        10      11       12       )
	abbr_names=( Jan Feb Mar Apr Jun Jul Aug Sep Oct Nov Dec )
	abbr_nums=(  01  02  03  04  06  07  08  09  10  11  12 )

	local sed_expr="" i
	for (( i = 1; i <= ${#full_names[@]}; i++ )); do
		sed_expr+="s/(^|[^a-zA-Z])(${full_names[$i]})([^a-zA-Z]|\$)/\1${full_nums[$i]}\3/gI;"
	done
	for (( i = 1; i <= ${#abbr_names[@]}; i++ )); do
		sed_expr+="s/(^|[^a-zA-Z])(${abbr_names[$i]})([^a-zA-Z]|\$)/\1${abbr_nums[$i]}\3/gI;"
	done
	sed_expr="${sed_expr%%;}"

	local f newf renamed=0
	for f in "${all_files[@]}"; do
		newf="$(printf '%s' "$f" | sed -E "$sed_expr")"
		if [[ "$newf" != "$f" ]]; then
			\mv "$f" "$newf"
			printf '%s -> %s\n' "$f" "$newf"
			(( renamed++ )) || true
		fi
	done
	if (( renamed == 0 )); then
		printf 'No files with month names found.\n'
	fi
}

cmd_util_ext() {
	if [[ "$#" -eq 0 ]]; then
		nt_err "usage: nt util ext <extension>"
		exit 1
	fi
	local new_ext="$1"

	local -a all_docs
	if [[ -n "$_nt_prefix" ]]; then
		all_docs=( ${_nt_prefix}[[:digit:]]##*(N.) )
	else
		all_docs=( [[:digit:]]##*(N.) )
	fi

	local f idx cur_ext stem newf renamed=0
	for f in "${all_docs[@]}"; do
		nt_is_skip_ext "$f" && continue
		idx="$(extract_index "$f")"
		[[ -z "$idx" ]] && continue
		cur_ext="$(get_extension "$f" 2>/dev/null)" || cur_ext="${f##*.}"
		[[ "$cur_ext" == "$new_ext" ]] && continue
		stem="${f%.*}"
		newf="${stem}.${new_ext}"
		\mv "$f" "$newf"
		printf '%s -> %s\n' "$f" "$newf"
		(( renamed++ )) || true
	done
	if (( renamed == 0 )); then
		printf 'No nt-indexed files with a different extension found to update.\n'
	fi
}

cmd_util_delim() {
	if [[ "$#" -eq 0 ]]; then
		nt_err "usage: nt util delim <delimiter>"
		exit 1
	fi
	local new_delim="$1"

	local -a all_docs
	if [[ -n "$_nt_prefix" ]]; then
		all_docs=( ${_nt_prefix}[[:digit:]]##*(N.) )
	else
		all_docs=( [[:digit:]]##*(N.) )
	fi

	local f idx cur_delim rest newf renamed=0
	for f in "${all_docs[@]}"; do
		nt_is_skip_ext "$f" && continue
		idx="$(extract_index "$f")"
		[[ -z "$idx" ]] && continue
		cur_delim="$(get_delimiter "$f")"
		[[ -z "$cur_delim" ]] && continue
		[[ "$cur_delim" == "$new_delim" ]] && continue
		rest="${f#${_nt_prefix}${idx}${cur_delim}}"
		newf="${_nt_prefix}${idx}${new_delim}${rest}"
		\mv "$f" "$newf"
		printf '%s -> %s\n' "$f" "$newf"
		(( renamed++ )) || true
	done
	if (( renamed == 0 )); then
		printf 'No nt-indexed files with delimiters found to update.\n'
	fi
}


if [ "$#" -eq 0 ]; then
	cmd_help
	exit 0
fi

nt_platform_detect
nt_load_config
typeset -aU files_to_open=()
_nt_consumed=0
_nt_greedy=0
setopt extended_glob 2>/dev/null

_nt_shift_consumed() {
	_nc=$_nt_consumed
	while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
}

while [ "$#" -gt 0 ]; do
	case "$1" in


		n|new)
			shift; _nt_greedy=1; cmd_new "$@"
			_nc=$_nt_consumed
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;

		l|last)
			shift; _nt_greedy=1; cmd_last "$@"
			_nc=$_nt_consumed
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;

		li|last-index|-li|--last-index)
			cmd_last_index; break ;;

		r|rename)
			shift; _nt_greedy=1; cmd_rename "$@"
			_nc=$(( 1 + _nt_consumed ))
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;

		rl)
			shift; _nt_greedy=1; cmd_rename_last "$@"
			_nc=$_nt_consumed
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;


		-n|--new)
			shift; _nt_greedy=0; cmd_new "$@"
			_nc=$_nt_consumed
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;

		-l|--last)
			shift; _nt_greedy=0; cmd_last "$@"
			_nc=$_nt_consumed
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;

		-r|--rename)
			shift; _nt_greedy=0; cmd_rename "$@"
			_nc=$(( 1 + _nt_consumed ))
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;

		-rl|--rl)
			shift; _nt_greedy=0; cmd_rename_last "$@"
			_nc=$_nt_consumed
			while [ "$_nc" -gt 0 ] && [ "$#" -gt 0 ]; do shift; _nc=$(( _nc - 1 )); done
			;;


		ri|reindex|-ri|--reindex)
			shift; cmd_reindex "$@"; break ;;

		config)
			shift; cmd_config "$@"; break ;;

		util)
			shift
			if [[ "$#" -eq 0 ]]; then
				nt_err "usage: nt util month | nt util delim <delimiter> | nt util ext <extension>"
				exit 2
			fi
			case "$1" in
				month)  cmd_util_month; break ;;
				delim)  shift; cmd_util_delim "$@"; break ;;
				ext)    shift; cmd_util_ext "$@"; break ;;
				*)
					nt_err "Unknown util subcommand: $1"
					nt_err "usage: nt util month | nt util delim <delimiter> | nt util ext <extension>"
					exit 2 ;;
			esac
			;;

		a|activity|-a|--activity)
			cmd_activity "a"; break ;;

		ar|activity-recursive|-ar|--activity-recursive)
			cmd_activity "ar"; break ;;

		h|help|-h|--help)
			cmd_help; break ;;

		v|version|-v|--version)
			cmd_version; break ;;

		R|-R)     cmd_readme;   shift ;;
		C|-C)     cmd_claude;   shift ;;
		t|-t)     cmd_template; shift ;;

		[0123456789]*-[0123456789]*)
			if [[ "$1" =~ $_nt_range_pat ]]; then
				local _range_start="${1%%-*}" _range_end="${1##*-}"
				validate_index "$_range_start" || exit 2
				validate_index "$_range_end" || exit 2
				if [[ "$(compare_indices "$_range_start" "$_range_end")" == "1" ]]; then
					nt_err "Range start is greater than end: ${_range_start}-${_range_end}"
					exit 2
				fi
				local -a _range_all_docs _range_matches _range_filtered
				if [[ -n "$_nt_prefix" ]]; then
					_range_all_docs=( ${_nt_prefix}[[:digit:]]##*(N.) )
				else
					_range_all_docs=( [[:digit:]]##*(N.) )
				fi
				_range_filtered=()
				local _range_f _range_idx
				for _range_f in "${_range_all_docs[@]}"; do
					nt_is_skip_ext "$_range_f" || _range_filtered+=( "$_range_f" )
				done
				_range_all_docs=( "${_range_filtered[@]}" )
				_range_matches=()
				for _range_f in "${_range_all_docs[@]}"; do
					_range_idx="$(extract_index "$_range_f")"
					[[ -z "$_range_idx" ]] && continue
					if [[ "$(compare_indices "$_range_start" "$_range_idx")" != "1" ]] \
						&& [[ "$(compare_indices "$_range_idx" "$_range_end")" != "1" ]]; then
						_range_matches+=( "$_range_f" )
					fi
				done
				if [[ ${#_range_matches[@]} -eq 0 ]]; then
					nt_err "No documents found in range ${_range_start}-${_range_end}."
					exit 2
				fi
				local _range_sorted
				_range_sorted="$(sort_docs_by_index "${_range_matches[@]}")"
				local _range_line
				while IFS= read -r _range_line; do
					files_to_open+=( "$_range_line" )
				done <<< "$_range_sorted"
				shift
			else
				nt_err "Unknown option '$1'"; exit 2
			fi
			;;

		[0123456789]*..)
			cmd_subtree "${1%..}" all; shift ;;
		-[0123456789]*..)
			cmd_subtree "${${1#-}%..}" all; shift ;;
		[0123456789]*.)
			cmd_subtree "${1%.}" immediate; shift ;;
		-[0123456789]*.)
			cmd_subtree "${${1#-}%.}" immediate; shift ;;

		[0123456789]*)
			if [[ "$1" =~ $_nt_idx_strict ]]; then
				cmd_open "$1"; shift
			else
				nt_err "Unknown option '$1'"; exit 2
			fi
			;;

		-[0123456789]*)
			if [[ "${1#-}" =~ $_nt_idx_strict ]]; then
				cmd_open "${1#-}"; shift
			else
				nt_err "Unknown option '$1'"; exit 2
			fi
			;;

		*)        nt_err "Unknown option '$1'"; exit 2 ;;
	esac
done

unsetopt extended_glob 2>/dev/null

if [ "${#files_to_open[@]}" -gt 0 ]; then
	nt_open "${nt_editor}" "${files_to_open[@]}"
fi
